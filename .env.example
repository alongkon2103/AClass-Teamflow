# ---- Database (PostgreSQL 16) ----
# App runtime connection.
#   Supabase: use the "Connection pooling" URL (port 6543) and append
#             ?pgbouncer=true&connection_limit=1
#   Local docker (docker compose up -d): the URL below.
DATABASE_URL="postgresql://teamflow:teamflow@localhost:5432/teamflow"

# Direct connection — used ONLY by Prisma migrations (no pgBouncer).
#   Supabase: use the "Direct connection" URL (port 5432).
#   Local docker: same as DATABASE_URL.
DIRECT_URL="postgresql://teamflow:teamflow@localhost:5432/teamflow"

# ---- Auth (Auth.js / NextAuth v5) ----
# Session + JWT signing secret. Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-characters-of-random-secret"

# Public origin of the app. Optional in dev (inferred from the request),
# required in production for correct callback URLs.
# AUTH_URL="http://localhost:3000"

# ---- Object storage for progress images (configured in Phase 5) ----
# STORAGE_PROVIDER="vercel-blob"        # or "s3"
# BLOB_READ_WRITE_TOKEN=""              # when STORAGE_PROVIDER=vercel-blob
# S3_ENDPOINT="https://..."             # when STORAGE_PROVIDER=s3
# S3_REGION="auto"
# S3_BUCKET="teamflow-progress"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
